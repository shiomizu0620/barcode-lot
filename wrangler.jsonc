{
  // Cloudflare Workers：静的ファイル（dist）＋ /api/* だけWorkerで処理
  "name": "barcode-lot",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
  // Yahoo!のClient IDは `npx wrangler secret put YAHOO_APPID` で設定（任意）
}
